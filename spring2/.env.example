# Copy to .env and fill in real values.
# Loaded automatically at startup (see DotenvEnvironmentPostProcessor) from:
#   - $CATALINA_BASE/.env               (WAR deployed into Tomcat)
#   - $JBOSS_HOME/standalone/.env       (WAR deployed into JBoss EAP / WildFly)
#   - ./.env                            (mvn spring-boot:run / java -jar, run from project root)
# Real OS environment variables always take priority over this file.

# --- Database ---
DB_NAME=rentaldb
DB_USERNAME=rentalapp
DB_PASSWORD=huber
DB_HOST=localhost
DB_PORT=3306
# Escape hatch - if set, used verbatim, overriding DB_HOST/DB_PORT/DB_NAME above.
# DB_URL=jdbc:mysql://localhost:3306/rentaldb?useSSL=false&serverTimezone=UTC
DB_LOG_SQL=false
DB_POOL_SIZE=10

# --- Branding ---
APP_NAME=RentalApp
APP_TAGLINE=Rental management
APP_THEME=slate

# --- Admin login ---
ADMIN_USERNAME=rentalapp
# BCrypt hash only - generate with:
#   mvn compile exec:java -Dexec.args="your-real-password"
ADMIN_PASSWORD_HASH=$2a$10$773/ATit8ybUn4AKlKEIAOJKM.mOHY5N1BqVusee74CuNPKkRxJOa

# --- Only used by the embedded container (mvn spring-boot:run / java -jar) ---
SERVER_PORT=8080
CONTEXT_PATH=/
